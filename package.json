{
  "name": "flomad-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development SUPPRESS_BASELINE_WARNING=true next dev -p 3000",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start",
    "lint": "eslint .",
    "prepare": "husky install",
    "test": "jest",
    "test:ci": "jest --watch=false --silent",
    "test:watch": "jest --watch",
    "test:map": "node test-map.js",
    "test:map:all": "node test-map.js --all",
    "test:map:coverage": "jest \"src/(services|components/features/map)/__tests__/\" --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:performance": "playwright test tests/performance --reporter=html",
    "test:performance:ui": "playwright test tests/performance --ui",
    "test:websocket:advanced": "playwright test tests/e2e/websocket-advanced.spec.ts",
    "test:websocket:advanced:ui": "playwright test tests/e2e/websocket-advanced.spec.ts --ui",
    "test:load:chat": "k6 run tests/load/chat-load.js",
    "test:load:websocket": "k6 run tests/load/websocket-load.js",
    "test:load:smoke": "k6 run --vus 10 --duration 30s tests/load/chat-load.js",
    "test:all": "npm run test && npm run test:e2e && npm run test:performance",
    "check-env": "ts-node scripts/checkEnv.ts",
    "analyze": "cross-env ANALYZE=true next build",
    "build:analyze": "cross-env ANALYZE=true npm run build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.1.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@stomp/stompjs": "^7.2.1",
    "@types/lodash": "^4.17.20",
    "@types/react-window": "^2.0.0",
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.15.1",
    "jest-mock": "^30.2.0",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "lucide-react": "^0.427.0",
    "next": "^16.0.10",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^9.1.0",
    "react-window": "^2.2.3",
    "sockjs-client": "^1.6.1",
    "stompjs": "^2.3.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/sockjs-client": "^1.5.4",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.9.7",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^6.0.0-rc.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "shadcn-ui": "^0.9.5",
    "tailwindcss": "^3.4.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "next@>=15.0.0 <15.1.0": ">=15.1.0",
      "next@>=15.0.0 <15.1.2": ">=15.1.2",
      "next@>=15.0.0 <15.1.6": ">=15.1.6",
      "next@>=15.0.0 <15.2.2": ">=15.2.2",
      "next@>=15.0.4-canary.51 <15.1.8": ">=15.1.8",
      "next@>=15.0.0 <15.2.3": ">=15.2.3",
      "next@>=15.0.0 <=15.4.4": ">=15.4.5",
      "next@>=15.0.0-canary.0 <15.4.7": ">=15.4.7"
    }
  }
}
