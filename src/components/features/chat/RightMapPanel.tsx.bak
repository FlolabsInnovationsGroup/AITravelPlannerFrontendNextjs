import GoogleMapComponent from "@/components/features/map/GoogleMapComponent";
import { Client, Frame } from '@stomp/stompjs';
import SockJS from 'sockjs-client';
import Image from "next/image";
import { Location, LocationType } from "@/types/map";
import { getLocationsBySession } from "@/lib/api";

// Constants
const RETRY_DELAY = 3000; // 3 seconds
const MAX_RETRIES = 5;

interface WebSocketEvent {
    type: string;
    payload: any;
}

interface RightMapPanelProps {
    currentSessionId: string | null;
    currentUserToken: string | null;
}

const RightMapPanel: React.FC<RightMapPanelProps> = ({
    currentSessionId,
    currentUserToken,
}) => {
    // State management
    const [locations, setLocations] = useState<Location[]>([]);
    const [isFullScreen, setIsFullScreen] = useState(false);
    const [isConnecting, setIsConnecting] = useState(false);
    const [connectionError, setConnectionError] = useState<string | null>(null);
    const [retryCount, setRetryCount] = useState(0);
    const [isLoading, setIsLoading] = useState(true);

    // Refs
    const stompClientRef = useRef<Client | null>(null);
    const reconnectTimeoutRef = useRef<NodeJS.Timeout>();

    // Fetch initial locations
    const fetchLocations = useCallback(async () => {
        if (!currentSessionId) return;
        try {
            const initialLocations = await getLocationsBySession(currentSessionId);
            if (Array.isArray(initialLocations)) {
                const typedLocations = initialLocations.map(loc => ({
                    ...loc,
                    type: loc.type as LocationType
                }));
                setLocations(typedLocations);
            }
        } catch (error) {
            console.error("Error fetching initial locations:", error);
            setConnectionError("Failed to fetch initial locations");
        } finally {
            setIsLoading(false);
        }
    }, [currentSessionId]);

    const fetchLocations = useCallback(async () => {
        if (!currentSessionId) return;
        try {
            const initialLocations = await getLocationsBySession(currentSessionId);
            if (Array.isArray(initialLocations)) {
                const typedLocations = initialLocations.map(loc => ({
                    ...loc,
                    type: loc.type as LocationType
                }));
                setLocations(typedLocations);
            }
        } catch (error) {
            console.error("Error fetching initial locations:", error);
            setConnectionError("Failed to fetch initial locations");
        } finally {
            setIsLoading(false);
        }
    }, [currentSessionId]);

    const handleWebSocketEvent = useCallback((type: string, payload: any) => {
        if (type === 'LOCATION_ADDED') {
            setLocations(prev => {
                // Check if location already exists
                if (prev.some(loc => loc.id === payload.id)) {
                    return prev;
                }
                return [...prev, payload];
            });
        } else if (type === 'LOCATION_UPDATED') {
            setLocations(prev => prev.map(loc => 
                loc.id === payload.id ? payload : loc
            ));
        } else if (type === 'LOCATION_REMOVED') {
            setLocations(prev => prev.filter(loc => loc.id !== payload.id));
        }
    }, []);

    // Initialize WebSocket connection
    useEffect(() => {
        if (!currentSessionId || !currentUserToken) return;
        connectWebSocket(0);

        // Cleanup function
        return () => {
            if (reconnectTimeoutRef.current) {
                clearTimeout(reconnectTimeoutRef.current);
            }
            if (stompClientRef.current) {
                stompClientRef.current.deactivate();
                stompClientRef.current = null;
            }
        };
    }, [currentSessionId, currentUserToken, connectWebSocket]);

    // Fetch initial locations
    useEffect(() => {
        fetchLocations();
    }, [fetchLocations]);

    const toggleFullScreen = () => {
        setIsFullScreen((prev) => !prev);
    };

    const stompClientRef = useRef<Client | null>(null);
    const reconnectTimeoutRef = useRef<NodeJS.Timeout>();

    const connectWebSocket = useCallback((retryAttempt: number = 0) => {
        if (!currentSessionId || !currentUserToken) {
            setConnectionError("Session ID or user token is missing.");
            return;
        }

        if (retryAttempt >= MAX_RETRIES) {
            setConnectionError("Failed to connect after multiple attempts. Please refresh the page to try again.");
            setIsConnecting(false);
            return;
        }

        // Clean up existing connection and timeout
        if (stompClientRef.current) {
            stompClientRef.current.deactivate();
            stompClientRef.current = null;
        }
        if (reconnectTimeoutRef.current) {
            clearTimeout(reconnectTimeoutRef.current);
        }

        setIsConnecting(true);
        setConnectionError(null);
        setRetryCount(retryAttempt);
        console.log(`🔄 Connecting WebSocket for session: ${currentSessionId} (Attempt ${retryAttempt + 1}/${MAX_RETRIES})`);

        const socketUrl = process.env.NODE_ENV === 'development' 
            ? 'http://localhost:8080/ws'
            : 'https://api.flomadtravel.com/ws';

        try {
            const client = new Client({
                webSocketFactory: () => new SockJS(socketUrl, null, {
                    transports: ['websocket', 'xhr-streaming', 'xhr-polling'],
                    timeout: 10000,
                }),
                connectHeaders: {
                    Authorization: `Bearer ${currentUserToken}`,
                    SessionId: currentSessionId,
                },
                debug: (str) => {
                    console.debug('🔄 STOMP:', str);
                },
                reconnectDelay: RETRY_DELAY,
                heartbeatIncoming: 4000,
                heartbeatOutgoing: 4000
            });

            client.onConnect = () => {
                console.log(`✅ WebSocket connected. Subscribing to: /topic/locations/${currentSessionId}`);
                setIsConnecting(false);
                setConnectionError(null);
                setRetryCount(0);

                client.subscribe(`/topic/locations/${currentSessionId}`, (message) => {
                    try {
                        const data = JSON.parse(message.body);
                        console.log("📡 WebSocket Received:", data);
                        handleWebSocketEvent(data.type, data.payload);
                    } catch (error) {
                        console.error("🚨 Error parsing WebSocket message:", error);
                    }
                });
            };

            client.onStompError = (frame: Frame) => {
                console.error("❌ WebSocket STOMP error:", frame.headers["message"]);
                setConnectionError(`Connection error: ${frame.headers["message"]}`);
                
                // Attempt to reconnect with backoff
                reconnectTimeoutRef.current = setTimeout(() => {
                    if (stompClientRef.current) {
                        console.log("🔄 Attempting to reconnect...");
                        stompClientRef.current.deactivate();
                        connectWebSocket(retryCount + 1);
                    }
                }, RETRY_DELAY * (retryCount + 1));
            };

            client.onWebSocketError = (event: Event) => {
                console.error("❌ WebSocket error:", event);
                setConnectionError("Connection error occurred. Attempting to reconnect...");
                reconnectTimeoutRef.current = setTimeout(() => {
                    connectWebSocket(retryCount + 1);
                }, RETRY_DELAY * (retryCount + 1));
            };

    client.onConnect = () => {
        console.log(`✅ WebSocket connected. Subscribing to: /topic/locations/${currentSessionId}`);
        setIsConnecting(false);
        setConnectionError(null);
        setRetryCount(0);

        client.subscribe(`/topic/locations/${currentSessionId}`, (message) => {
            try {
                const data = JSON.parse(message.body);
                console.log("📡 WebSocket Received:", data);
                handleWebSocketEvent(data.type, data.payload);
            } catch (error) {
                console.error("🚨 Error parsing WebSocket message:", error);
            }
        });
    };

    client.onStompError = (frame) => {
        console.error("❌ WebSocket STOMP error:", frame.headers["message"]);
        setConnectionError(`Connection error: ${frame.headers["message"]}`);
        
        // Attempt to reconnect with backoff
        reconnectTimeoutRef.current = setTimeout(() => {
            if (stompClientRef.current) {
                console.log("🔄 Attempting to reconnect...");
                stompClientRef.current.deactivate();
                connectWebSocket(retryCount + 1);
            }
        }, RETRY_DELAY * (retryCount + 1));
            }
        }, 5000);
    };

    client.onWebSocketError = (event) => {
        console.error("🚨 WebSocket error:", event);
    };

    client.onWebSocketClose = () => {
        console.log("⚠️ WebSocket connection closed");
    };

    console.log("🔄 Activating WebSocket connection...");
    client.activate();
    stompClientRef.current = client;

    // Fetch initial locations for the session
    const fetchLocations = async () => {
        try {
            const initialLocations = await getLocationsBySession(currentSessionId);
            if (initialLocations?.length > 0) {
                // Convert the locations to the correct type
                const typedLocations = initialLocations.map(loc => ({
                    ...loc,
                    type: (loc.type || 'attraction') as LocationType
                }));
                setLocations(typedLocations);
            }
        } catch (error) {
            console.error("❌ Error fetching initial locations:", error);
        }
    };
    fetchLocations();

    return () => {
        if (stompClientRef.current) {
            console.log("🔌 Disconnecting WebSocket...");
            stompClientRef.current.deactivate();
            stompClientRef.current = null;
        }
    };
    // Location event listener
    useEffect(() => {
        const handleNewLocation = (event: CustomEvent<Location>) => {
            console.log("📍 New location received:", event.detail);
            setLocations(prev => {
                // Check if location already exists
                if (prev.some(loc => 
                    loc.latitude === event.detail.latitude && 
                    loc.longitude === event.detail.longitude
                )) {
                    console.log("⚠️ Location already exists, skipping");
                    return prev;
                }
                return [...prev, event.detail];
            });
        };

        window.addEventListener('newLocation', handleNewLocation as EventListener);
        return () => {
            window.removeEventListener('newLocation', handleNewLocation as EventListener);
        };
    }, []);

}, [currentSessionId, currentUserToken]);

        const handleWebSocketEvent = useCallback((type: string, payload: any) => {
        if (!payload || !payload.id) {
            console.error("🚨 Invalid WebSocket payload:", payload);
            return;
        }
    
        console.log(`📡 WebSocket Received [${type}]:`, payload);
    
        setLocations((prevLocations) => {
            const locationIds = new Set(prevLocations.map(loc => loc.id));
    
            switch (type) {
                case "LOCATION_ADDED":
                    if (!locationIds.has(payload.id)) {
                        console.log("✅ Adding new location:", payload);
                        return [...prevLocations, payload];
                    } else {
                        console.warn("⚠️ Duplicate location detected, skipping:", payload);
                        return prevLocations;
                    }
                case "LOCATION_UPDATED":
                    return prevLocations.map(loc => loc.id === payload.id ? payload : loc);
                case "LOCATION_REMOVED":
                    return prevLocations.filter(loc => loc.id !== payload.id);
                case "MAP_CLEARED":
                    console.log("🗺 Clearing all locations.");
                    return [];
                default:
                    console.warn("⚠️ Unknown WebSocket event type:", type);
                    return prevLocations;
            }
        });
    }, []);
    
    
    

    return (
        <div
            className={`${
                isFullScreen ? "absolute inset-0 z-50" : "hidden md:block flex-grow"
            } bg-white border-l h-screen p-4 overflow-hidden`}
        >
            <div
                className={`relative h-full w-full ${
                    isFullScreen ? "fullscreen-map" : ""
                }`}
            >
                {locations.length > 0 ? (
                    <div className="h-full w-full p-2 bg-white rounded-lg">
                        <GoogleMapComponent
                            locations={locations}
                        />
                    </div>
                ) : (

                    <div className="flex items-center justify-center h-full w-full p-2">
                        <div className="relative h-full w-full bg-white rounded-lg">
                            <Image
                                src="/image/travelagentpic1.png"
                                alt="Your Personal AI Travel Agent"
                                fill
                                sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                                className="object-cover rounded-lg"
                                priority
                            />
                        </div>
                    </div>
                )}
            </div>
        </div>
    );
};

export default RightMapPanel;
